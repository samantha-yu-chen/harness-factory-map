{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/harness-factory-map/spec.schema.json",
  "title": "Harness Factory Map Specification",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "entity_type",
    "plane",
    "scope",
    "status",
    "risk",
    "actor_type",
    "description",
    "owner",
    "exec_summary",
    "human_accountable"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "entity_type": {
      "enum": [
        "actor",
        "component",
        "artifact",
        "decision",
        "external-system",
        "workflow-step"
      ]
    },
    "plane": {
      "enum": [
        "request",
        "knowledge",
        "control",
        "governance",
        "execution",
        "assurance",
        "learning",
        "external"
      ]
    },
    "scope": {
      "enum": [
        "mvp",
        "next",
        "future"
      ]
    },
    "status": {
      "enum": [
        "idea",
        "specified",
        "ready",
        "building",
        "implemented",
        "validated",
        "production-ready",
        "blocked"
      ]
    },
    "risk": {
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ]
    },
    "actor_type": {
      "enum": [
        "human",
        "agent",
        "deterministic-system",
        "external"
      ]
    },
    "automation_level": {
      "description": "How much of this boundary a machine is allowed to decide on its own.",
      "enum": [
        "human-only",
        "human-approves",
        "agent-with-review",
        "agent-autonomous",
        "deterministic"
      ]
    },
    "data_classification": {
      "enum": [
        "public",
        "internal",
        "confidential",
        "restricted",
        "none"
      ]
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "exec_summary": {
      "description": "One plain-language sentence for a non-technical reader. No product or service names.",
      "type": "string",
      "minLength": 1
    },
    "business_value": {
      "description": "Why a leadership team should fund this boundary.",
      "type": "string"
    },
    "owner": {
      "description": "Delivery team accountable for building and running this boundary.",
      "type": "string",
      "minLength": 1
    },
    "human_accountable": {
      "description": "Named human role that answers for this boundary's decisions.",
      "type": "string",
      "minLength": 1
    },
    "build_wave": {
      "description": "Delivery wave. 1 is the walking skeleton; 4 is the learning loop.",
      "type": "integer",
      "minimum": 1,
      "maximum": 4
    },
    "stage_order": {
      "description": "Position of a workflow-step within its loop. Stage 0 is the always-on platform band; 1-7 are the factory loop; 8-12 are the runtime loop.",
      "type": "integer",
      "minimum": 0,
      "maximum": 12
    },
    "loop": {
      "description": "Workflow-step only. Which band this stage belongs to. The platform band is always on; the factory loop runs once per solution; the runtime loop runs on every invocation of a published agent; the learning band closes both.",
      "enum": [
        "platform",
        "factory",
        "runtime",
        "learning"
      ]
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true,
      "default": []
    },
    "depends_on": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true,
      "default": []
    },
    "connects_to": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true,
      "default": []
    },
    "workflow_order": {
      "type": "integer",
      "minimum": 1
    },
    "serves_stages": {
      "description": "Additional stages this component participates in beyond its home workflow_id. Used where the runtime loop deliberately reuses factory machinery rather than duplicating it.",
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      },
      "uniqueItems": true,
      "default": []
    },
    "workflow_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "reference_elements": {
      "description": "Workflow-step only. Canonical boxes drawn in the reference diagram for this stage. Every element must be claimed by at least one component or the map reports a coverage gap.",
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true,
      "default": []
    },
    "reference_map": {
      "description": "Component only. Reference-diagram elements this component implements. Unknown values fail generation.",
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true,
      "default": []
    },
    "responsibilities": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "owns": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "does_not_own": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "data_owned": {
      "description": "Authoritative state objects. Exactly one component may own each object.",
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true,
      "default": []
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "outputs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "permissions": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "restrictions": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "failure_behaviour": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "open_questions": {
      "description": "Honest unknowns. These surface in the map as amber, not as silent gaps.",
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "api_contract": {
      "description": "The callable surface. Each entry names exactly one caller and one worker.",
      "type": "array",
      "default": [],
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "operation",
          "kind",
          "caller",
          "worker",
          "request",
          "response",
          "failure"
        ],
        "properties": {
          "operation": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "sync-api",
              "async-event",
              "batch-job",
              "human-decision",
              "query"
            ]
          },
          "caller": {
            "description": "Who initiates. Always a named component, channel, or human role.",
            "type": "string",
            "minLength": 1
          },
          "worker": {
            "description": "Who performs the work and owns the result.",
            "type": "string",
            "minLength": 1
          },
          "request": {
            "type": "string",
            "minLength": 1
          },
          "response": {
            "type": "string",
            "minLength": 1
          },
          "idempotency": {
            "type": "string"
          },
          "timeout": {
            "type": "string"
          },
          "auth": {
            "type": "string"
          },
          "failure": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "events_emitted": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true,
      "default": []
    },
    "events_consumed": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true,
      "default": []
    },
    "slo": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "availability": {
          "type": "string"
        },
        "latency": {
          "type": "string"
        },
        "throughput": {
          "type": "string"
        },
        "recovery": {
          "type": "string"
        }
      }
    },
    "cost": {
      "description": "MVP running cost. Ranges are monthly USD for one non-production environment at the stated volume driver.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "monthly_usd_low",
        "monthly_usd_high",
        "driver"
      ],
      "properties": {
        "monthly_usd_low": {
          "type": "number",
          "minimum": 0
        },
        "monthly_usd_high": {
          "type": "number",
          "minimum": 0
        },
        "model_usd_per_task_low": {
          "type": "number",
          "minimum": 0
        },
        "model_usd_per_task_high": {
          "type": "number",
          "minimum": 0
        },
        "driver": {
          "type": "string",
          "minLength": 1
        },
        "note": {
          "type": "string"
        },
        "azure": {
          "type": "array",
          "default": [],
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "service",
              "sku",
              "monthly_usd_low",
              "monthly_usd_high"
            ],
            "properties": {
              "service": {
                "type": "string",
                "minLength": 1
              },
              "sku": {
                "type": "string",
                "minLength": 1
              },
              "monthly_usd_low": {
                "type": "number",
                "minimum": 0
              },
              "monthly_usd_high": {
                "type": "number",
                "minimum": 0
              },
              "note": {
                "type": "string"
              },
              "shared": {
                "description": "True when the same instance is shared with other components. Shared lines are counted once in the platform rollup.",
                "type": "boolean",
                "default": false
              }
            }
          }
        }
      }
    }
  }
}
